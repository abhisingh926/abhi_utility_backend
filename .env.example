# Copy to .env (locally) or add each line as an Environment Variable in Hostinger hPanel.
# In .env files a "#" starts a comment: put values containing # in quotes, e.g. ADMIN_PASSWORD="Pa#ss123".

NODE_ENV=production
# Hostinger sets PORT itself; leave it out there.
PORT=3000
PUBLIC_URL=https://palegreen-whale-996077.hostingersite.com

# ---- MySQL (hPanel → Databases → MySQL Databases) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u000000000_abhi
DB_USER=u000000000_abhi
DB_PASSWORD=change-me

# ---- Login tokens ----
# Long random secret (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=60

# ---- First admin (created on first start; change the password after logging in) ----
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-now

# ---- Email (for "Forgot password" codes) ----
# Hostinger: hPanel → Emails → create e.g. no-reply@yourdomain, then:
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@yourdomain.com
SMTP_PASSWORD=mailbox-password
MAIL_FROM=no-reply@yourdomain.com
APP_NAME=Abhi Utility

# ---- Cloud backup of diary + tasks ----
# Folder for backup photos. Use a folder OUTSIDE the app folder on Hostinger
# (redeploying replaces the app folder), e.g. /home/u123456789/abhi_storage
STORAGE_DIR=./storage
BACKUP_KEEP=10
BACKUP_MAX_MB=10
BACKUP_PHOTO_MAX_MB=15
BACKUP_QUOTA_MB=1024
# true = only Pro users can back up
BACKUP_PRO_ONLY=false

# ---- SOS (no contact answered: location + video link sent by SMS) ----
# Videos are stored in STORAGE_DIR/sos. Links (and videos) are deleted after SOS_LINK_DAYS.
SOS_LINK_DAYS=30
SOS_VIDEO_MAX_MB=60

# ---- Free trial ----
# Days of free Pro after registering (one trial per email, also after deleting the
# account). 0 = no trial. Don't also add a free trial to the Play Console base plan.
TRIAL_DAYS=30

# ---- Referral program ----
# A friend registers with your code -> you get this many extra days of Pro.
REFERRAL_DAYS=30
# Extra days for the new user who registers with a code (0 = only the normal free trial).
REFERRAL_FRIEND_DAYS=10
# Most rewards one person can earn in 365 days (more friends still count, without reward).
REFERRAL_MAX_PER_YEAR=12
# New users can enter a code up to this many days after registering.
REFERRAL_APPLY_DAYS=7
# Where the shared invite link points (default: the Play Store page).
# APP_DOWNLOAD_URL=https://play.google.com/store/apps/details?id=com.abhi.abhi_utility

# ---- Subscription product IDs (create the same IDs in Play Console / App Store Connect) ----
PRODUCT_MONTHLY=abhi_pro_monthly
PRODUCT_YEARLY=abhi_pro_yearly

# ---- Google Play (needed for real Android purchases) ----
GOOGLE_PACKAGE_NAME=com.abhi.abhi_utility
# Service-account key: path to the JSON file, or the whole JSON on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/google-service-account.json
# Random secret; the Pub/Sub push URL is https://<your-site>/webhooks/google?token=<this>
GOOGLE_RTDN_TOKEN=replace-with-another-random-secret

# ---- Apple App Store (only when the iPhone version is ready) ----
APPLE_BUNDLE_ID=com.abhi.abhiUtility
APPLE_APP_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey.p8
APPLE_ENVIRONMENT=Sandbox
APPLE_ROOT_CERTS_DIR=./certs/apple
